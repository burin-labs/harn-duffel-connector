import {
  external_action_execute,
  external_action_grant,
  external_action_intent,
  external_action_reconcile,
} from "std/external_action"
import {
  call,
  external_action_adapter,
  init,
  normalize_offer,
  order_disclosure_plan,
  request_descriptor,
  shutdown,
} from "../src/lib"

fn grant(intent, method = "test_fixture") {
  return external_action_grant(
    intent,
    {
      authorized_by: {kind: "user", id: "user-1"},
      authorization_method: method,
      authentication_assurance: "session",
      issued_at_ms: 0,
      expires_at_ms: 9999999999999,
      max_external_spend: {currency: "USD", amount_minor: 12345},
    },
  )
}

fn booking_intent(payload = {}) {
  return external_action_intent(
    {
      actor: {kind: "user", id: "user-1"},
      provider: "duffel",
      capability: "flights.book",
      operation: "orders.create",
      environment: "test",
      payload: {
        offer_id: "off_test_123",
        total_amount: "123.45",
        total_currency: "USD",
        passengers: [{id: "pas_test_1", type: "adult"}],
      }
        + payload,
      protected_disclosure: order_disclosure_plan(),
      external_spend: {currency: "USD", amount_minor: 12345},
      display: {summary: "Book the selected Duffel test flight for $123.45"},
    },
  )
}

fn fictional_disclosure(intent, include_documents = false) {
  let classes = ["legal_identity", "birth_date", "contact_details"]
  let values = {
    legal_identity: {title: "ms", given_name: "Test", family_name: "Traveler", gender: "f"},
    birth_date: "1990-01-01",
    contact_details: {email: "traveler@example.invalid", phone: "+15550101000"},
  }
  if include_documents {
    classes = classes + ["travel_documents"]
    values.travel_documents = [
      {
        document_type: "passport",
        issuing_country: "US",
        number: "TEST000000",
        expiry_date: "2099-01-01",
      },
    ]
  }
  return {
    schema: "harn.external_action_disclosure.v1",
    intent_fingerprint: intent.fingerprint,
    provider: "duffel",
    operation: "orders.create",
    recipient: "Duffel test mode",
    purpose: "Create the exact approved fictional test order.",
    field_classes: classes,
    source: "fictional_test_fixture",
    authentication_assurance: "session",
    protected_values: values,
  }
}

fn disclosure_resolver(disclosure) {
  return {id: "fictional-test-profile", disclose: { _harness, _request -> disclosure }}
}

fn fresh_offer(amount = "123.45", expires_at = "2099-01-01T00:00:00Z") {
  return {
    data: {
      id: "off_test_123",
      total_amount: amount,
      total_currency: "USD",
      expires_at: expires_at,
      owner: {id: "arl_test", name: "Duffel Airways", iata_code: "ZZ"},
      passengers: [{id: "pas_test_1", type: "adult"}],
      slices: [
        {
          id: "sli_out",
          origin: {iata_code: "SFO"},
          destination: {iata_code: "JFK"},
          duration: "PT5H30M",
          segments: [
            {
              id: "seg_out",
              origin: {iata_code: "SFO"},
              destination: {iata_code: "JFK"},
              departing_at: "2026-10-10T08:00:00",
              arriving_at: "2026-10-10T16:30:00",
              duration: "PT5H30M",
              marketing_carrier: {name: "Duffel Airways"},
              marketing_carrier_flight_number: "123",
              operating_carrier: {name: "Duffel Airways"},
              aircraft: {name: "Boeing 787"},
              stops: [],
            },
          ],
        },
      ],
    },
  }
}

pipeline test_duffel_smoke(harness: Harness) {
  harness.runtime.checkpoint_clear()
  harness.testing.http_mock_clear()
  shutdown(harness)
  init(harness, {access_token: "duffel_test_fixture"})
  const live_token = request_descriptor(
    "offers.get",
    {access_token: "duffel_live_forbidden", offer_id: "off_1"},
  )
  assert(is_err(live_token), "live token must be rejected structurally")
  assert(unwrap_err(live_token).code == "live_token_rejected", "live token denial is typed")
  const direct_order = call(harness, "orders.create", {offer_id: "off_test_123"})
  assert(is_err(direct_order), "direct order creation must be rejected")
  assert(
    unwrap_err(direct_order).code == "external_action_required",
    "booking names the external-action requirement",
  )
  const search = request_descriptor(
    "offer_requests.create",
    {
      slices: [{origin: "SFO", destination: "JFK", departure_date: "2026-10-10"}],
      passengers: [{type: "adult"}],
      cabin_class: "economy",
      return_offers: false,
    },
  )
  assert(is_ok(search), "flight search descriptor builds")
  assert(unwrap(search).headers["Duffel-Version"] == "v2", "Duffel v2 is explicit")
  assert(
    unwrap(search).headers["Accept-Encoding"] == nil,
    "the HTTP transport owns response content encoding",
  )
  assert(
    unwrap(search).headers.Authorization == "Bearer duffel_test_fixture",
    "test token is sent only in the authorization header",
  )
  const normalized = normalize_offer(fresh_offer().data)
  assert(normalized.total_amount == "123.45", "comparison keeps exact decimal price")
  assert(
    normalized.passengers == [{id: "pas_test_1", type: "adult", age: nil}],
    "offer keeps the passenger reference needed for booking",
  )
  assert(normalized.slices[0].segments[0].stops == 0, "comparison exposes stop count")
  harness.testing.http_mock(
    "*",
    "https://api.duffel.com/*",
    {
      responses: [
        {status: 200, body: json_stringify(fresh_offer()), headers: {}},
        {status: 200, body: json_stringify(fresh_offer()), headers: {}},
        {
          status: 201,
          body:
            "{\"data\":{\"id\":\"ord_test_123\",\"offer_id\":\"off_test_123\",\"live_mode\":false}}",
          headers: {},
        },
      ],
    },
  )
  const researched = call(
    harness,
    "offer_requests.create",
    {
      access_token: "duffel_test_fixture",
      slices: [{origin: "SFO", destination: "JFK", departure_date: "2026-10-10"}],
      passengers: [{type: "adult"}],
      cabin_class: "economy",
    },
  )
  assert(is_ok(researched), "the public read interface installs its network policy")
  const intent = booking_intent()
  assert(
    !json_stringify(intent).contains("Test")
      && !json_stringify(intent).contains(
      "traveler@example.invalid",
    ),
    "intent and model arguments contain no protected values",
  )
  const adapter = unwrap(external_action_adapter())
  // A denial is terminal for one exact effect. Keep this negative control
  // distinct from the later approved booking so it cannot replay the denial.
  const incomplete_intent = booking_intent({offer_id: "off_missing_disclosure"})
  const incomplete = external_action_execute(
    harness,
    incomplete_intent,
    grant(incomplete_intent),
    adapter,
    nil,
    nil,
  )
  assert(incomplete.status == "denied", "missing protected disclosure must deny before dispatch")
  assert(
    incomplete.error?.code == "protected_disclosure_unavailable",
    "missing protected disclosure has a stable error code",
  )
  const resolver = disclosure_resolver(fictional_disclosure(intent))
  const booked = external_action_execute(harness, intent, grant(intent), adapter, nil, resolver)
  const replay = external_action_execute(harness, intent, grant(intent), adapter, nil, resolver)
  assert(booked.status == "confirmed", "test order confirms")
  assert(booked.provider_action_id == "ord_test_123", "receipt records Duffel order id")
  assert(
    booked.disclosure?.field_classes == ["legal_identity", "birth_date", "contact_details"],
    "receipt records only disclosed field classes",
  )
  assert(
    !json_stringify(booked).contains("Test")
      && !json_stringify(booked).contains(
      "traveler@example.invalid",
    ),
    "receipt excludes protected values",
  )
  assert(replay.id == booked.id, "duplicate delivery returns the same receipt")
  let calls = harness.testing.http_mock_calls({include_sensitive: false})
  assert(len(calls) == 3, "replay performs neither offer refresh nor order creation again")
  assert(calls[0].method == "POST", "research uses the public connector call interface")
  assert(calls[1].method == "GET", "booking refreshes the selected offer")
  assert(calls[2].method == "POST", "booking creates one order")
  const order_body: {data: dict} = json_parse(calls[2].body)
  assert(order_body.data.selected_offers == ["off_test_123"], "order binds one exact offer")
  assert(order_body.data.payments[0].amount == "123.45", "payment equals authorized price")
  assert(order_body.data.passengers[0].title == "ms", "adapter adds the disclosed passenger title")
  assert(
    order_body.data.passengers[0].given_name == "Test",
    "adapter adds protected values only at dispatch",
  )
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  const forbidden_intent = booking_intent(
    {passengers: [{id: "pas_test_1", type: "adult", given_name: "Model supplied"}]},
  )
  const forbidden = external_action_execute(
    harness,
    forbidden_intent,
    grant(forbidden_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(forbidden_intent)),
  )
  assert(
    forbidden.status == "failed_before_dispatch",
    "model-supplied identity stops before provider contact",
  )
  assert(
    forbidden.error?.code == "passenger_values_forbidden",
    "identity arguments have a stable denial",
  )
  assert(
    len(harness.testing.http_mock_calls({include_sensitive: false})) == 0,
    "forbidden identity arguments perform no request",
  )
  harness.runtime.checkpoint_clear()
  const mismatch_intent = booking_intent({offer_id: "off_passenger_mismatch"})
  const mismatched_offer = fresh_offer()
    + {
    data: fresh_offer().data
      + {
      id: "off_passenger_mismatch",
      passengers: [{id: "pas_changed", type: "adult"}],
    },
  }
  harness.testing.http_mock(
    "GET",
    "https://api.duffel.com/air/offers/*",
    {responses: [{status: 200, body: json_stringify(mismatched_offer), headers: {}}]},
  )
  const mismatch = external_action_execute(
    harness,
    mismatch_intent,
    grant(mismatch_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(mismatch_intent)),
  )
  assert(mismatch.status == "failed_before_dispatch", "changed passenger blocks order creation")
  assert(mismatch.error?.code == "passenger_offer_mismatch", "passenger mismatch is typed")
  assert(
    len(harness.testing.http_mock_calls({include_sensitive: false})) == 1,
    "passenger mismatch performs only the offer refresh",
  )
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  const document_intent = external_action_intent(
    intent
      + {protected_disclosure: order_disclosure_plan(true)},
  )
  const document_offer = fresh_offer()
    + {
    data: fresh_offer().data + {passenger_identity_documents_required: true},
  }
  harness.testing.http_mock(
    "*",
    "https://api.duffel.com/*",
    {
      responses: [
        {status: 200, body: json_stringify(document_offer), headers: {}},
        {
          status: 201,
          body: "{\"data\":{\"id\":\"ord_test_document\",\"live_mode\":false}}",
          headers: {},
        },
      ],
    },
  )
  const documented = external_action_execute(
    harness,
    document_intent,
    grant(document_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(document_intent, true)),
  )
  assert(documented.status == "confirmed", "required fictional travel document confirms")
  calls = harness.testing.http_mock_calls({include_sensitive: false})
  assert(len(calls) == 2, "document booking refreshes once and dispatches once")
  const document_order: {data: dict} = json_parse(calls[1].body)
  assert(
    document_order.data.passengers[0].identity_documents[0]
      == {
      type: "passport",
      unique_identifier: "TEST000000",
      issuing_country_code: "US",
      expires_on: "2099-01-01",
    },
    "adapter maps the purpose-bound document at dispatch",
  )
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  harness.testing.http_mock(
    "GET",
    "https://api.duffel.com/air/offers/*",
    {responses: [{status: 200, body: json_stringify(fresh_offer("124.00")), headers: {}}]},
  )
  const repriced_intent = booking_intent()
  const repriced = external_action_execute(
    harness,
    repriced_intent,
    grant(repriced_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(repriced_intent)),
  )
  assert(repriced.status == "failed_before_dispatch", "price change blocks order creation")
  assert(repriced.error?.code == "offer_price_changed", "changed price is typed")
  calls = harness.testing.http_mock_calls({include_sensitive: false})
  assert(len(calls) == 1 && calls[0].method == "GET", "failed refresh never posts an order")
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  const rejected_intent = booking_intent({offer_id: "off_test_rejected"})
  const rejected_offer = fresh_offer() + {data: fresh_offer().data + {id: "off_test_rejected"}}
  harness.testing.http_mock(
    "*",
    "https://api.duffel.com/*",
    {
      responses: [
        {status: 200, body: json_stringify(rejected_offer), headers: {}},
        {
          status: 422,
          body:
            "{\"errors\":[{\"code\":\"validation_required\",\"message\":\"Field 'title' can't be blank\",\"source\":{\"pointer\":\"/passengers/0/title\"}}]}",
          headers: {},
        },
      ],
    },
  )
  const rejected = external_action_execute(
    harness,
    rejected_intent,
    grant(rejected_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(rejected_intent)),
  )
  const rejected_replay = external_action_execute(
    harness,
    rejected_intent,
    grant(rejected_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(rejected_intent)),
  )
  assert(rejected.status == "rejected", "definite order 4xx is a dispatched rejection")
  assert(rejected.dispatch_attempted, "order 4xx records that provider dispatch occurred")
  assert(!rejected.error?.retryable, "definite rejection does not invite a retry")
  assert(
    rejected.error?.code == "validation_required:_passengers_0_title",
    "provider code keeps a sanitized validation pointer",
  )
  assert(rejected_replay.id == rejected.id, "rejection replay uses the durable receipt")
  calls = harness.testing.http_mock_calls({include_sensitive: false})
  assert(len(calls) == 2, "rejection replay sends neither refresh nor order again")
  assert(
    calls[0].method == "GET" && calls[1].method == "POST",
    "rejection follows one exact dispatch",
  )
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  harness.testing.http_mock(
    "*",
    "https://api.duffel.com/*",
    {
      responses: [
        {status: 200, body: json_stringify(fresh_offer()), headers: {}},
        {
          status: 503,
          body:
            "{\"errors\":[{\"code\":\"airline_internal\",\"message\":\"duffel_test_secret_should_not_survive\"}]}",
          headers: {},
        },
        {
          status: 200,
          body:
            "{\"data\":[{\"id\":\"ord_test_reconciled\",\"offer_id\":\"off_test_123\",\"live_mode\":false}]}",
          headers: {},
        },
      ],
    },
  )
  const uncertain_intent = booking_intent()
  const uncertain = external_action_execute(
    harness,
    uncertain_intent,
    grant(uncertain_intent),
    adapter,
    nil,
    disclosure_resolver(fictional_disclosure(uncertain_intent)),
  )
  assert(uncertain.status == "reconciliation_required", "order 503 remains indeterminate")
  assert(
    !json_stringify(uncertain).contains("secret_should_not_survive"),
    "provider body is absent from receipt",
  )
  const reconciled = external_action_reconcile(
    harness,
    uncertain_intent,
    grant(uncertain_intent),
    uncertain,
    adapter,
    "order-poll-1",
  )
  assert(reconciled.status == "confirmed", "offer-filtered order lookup reconciles")
  assert(reconciled.provider_action_id == "ord_test_reconciled", "reconciled order id recorded")
  calls = harness.testing.http_mock_calls({include_sensitive: false})
  assert(len(calls) == 3, "uncertain booking uses refresh, one create, and one query")
  assert(calls[0].method == "GET" && calls[1].method == "POST", "dispatch order is stable")
  assert(calls[2].method == "GET", "reconciliation is read-only")
  assert(calls[2].url.contains("offer_id=off_test_123"), "reconciliation filters exact offer")
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  const live_intent = external_action_intent(
    intent
      + {
      environment: "live",
      payload: intent.payload + {offer_id: "off_live_forbidden"},
      protected_disclosure: nil,
    },
  )
  const live_grant = external_action_grant(
    live_intent,
    {
      authorized_by: {kind: "user", id: "user-1"},
      authorization_method: "policy",
      authentication_assurance: "session",
      issued_at_ms: 0,
      expires_at_ms: 9999999999999,
      max_external_spend: {currency: "USD", amount_minor: 12345},
    },
  )
  const live = external_action_execute(harness, live_intent, live_grant, adapter)
  assert(live.status == "failed_before_dispatch", "live environment cannot reach Duffel")
  assert(live.error?.code == "live_booking_disabled", "live denial is typed")
  assert(
    len(harness.testing.http_mock_calls({include_sensitive: false})) == 0,
    "live denial makes no provider request",
  )
  harness.testing.http_mock_clear()
  harness.runtime.checkpoint_clear()
  shutdown(harness)
}
